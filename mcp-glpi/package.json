{
  "name": "@nextoolsolutions/mcp-glpi",
  "version": "3.5.2",
  "description": "MCP server for GLPI (service desk / ITSM): 166 GLPI tools for tickets, ITIL problems and changes, assets and inventory, knowledge base, users, rules and webhooks. GLPI 10 and 11, REST API v1 + GLPI 11 API v2 (OAuth2). Not affiliated with Teclib'.",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mcp-glpi": "dist/index.js",
    "mcp-glpi-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "glpi",
    "glpi-mcp",
    "glpi-api",
    "glpi-10",
    "glpi-11",
    "glpi11",
    "api-v2",
    "oauth2",
    "itsm",
    "itil",
    "service-desk",
    "helpdesk",
    "ticketing",
    "asset-management",
    "knowledge-base",
    "ai",
    "claude",
    "chatgpt",
    "cursor",
    "windsurf",
    "llm"
  ],
  "author": "NexTool Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexTools-Solutions/nextool-mcp-glpi.git",
    "directory": "mcp-glpi"
  },
  "homepage": "https://github.com/NexTools-Solutions/nextool-mcp-glpi/tree/main/mcp-glpi#readme",
  "bugs": {
    "url": "https://github.com/NexTools-Solutions/nextool-mcp-glpi/issues"
  },
  "mcpName": "com.nextoolsolutions/glpi",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@nextoolsolutions/mcp-glpi-core": "^1.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
