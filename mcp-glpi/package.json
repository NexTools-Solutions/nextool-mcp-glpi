{
  "name": "@nextoolsolutions/mcp-glpi",
  "version": "3.3.0",
  "description": "NexTool MCP for GLPI: connect AI assistants to GLPI through REST API v1 (110 tools) and GLPI 11 API v2 over OAuth2 (55 tools), with a write policy, MCP annotations, named toolsets, trimmed payloads, resources and prompts. Usable as a CLI (stdio/HTTP) or as a library. Not affiliated with Teclib'.",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mcp-glpi": "dist/index.js",
    "mcp-glpi-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "oauth2",
    "api-v2",
    "glpi11",
    "mcp",
    "glpi",
    "itsm",
    "itil",
    "helpdesk",
    "model-context-protocol",
    "ai",
    "claude",
    "cursor",
    "windsurf",
    "llm"
  ],
  "author": "NexTool Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexTools-Solutions/nextool-mcp-glpi.git",
    "directory": "mcp-glpi"
  },
  "homepage": "https://github.com/NexTools-Solutions/nextool-mcp-glpi/tree/main/mcp-glpi#readme",
  "bugs": {
    "url": "https://github.com/NexTools-Solutions/nextool-mcp-glpi/issues"
  },
  "mcpName": "io.github.NexTools-Solutions/mcp-glpi",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@nextoolsolutions/mcp-glpi-core": "^1.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
